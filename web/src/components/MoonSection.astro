---
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Moon } from "lucide-react";
import { getMoonInfo } from "@/lib/moon";
import { untilLabel } from "@/lib/format";
import { CARD_ICON } from "@/lib/utils";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const now = new Date();
const moon = getMoonInfo(now);

function dayLabel(d: Date): string {
  return d.toLocaleDateString("en-IE", {
    weekday: "short",
    day: "numeric",
    month: "short",
    timeZone: "Europe/Dublin",
  });
}
// The nearer of the two upcoming principal phases is listed first.
const phases = [
  { name: "Full moon", at: moon.nextFull },
  { name: "New moon", at: moon.nextNew },
].sort((a, b) => a.at.getTime() - b.at.getTime());
---

<Card className={className}>
  <CardHeader className="flex items-center gap-2">
    <Moon className={CARD_ICON} aria-hidden="true" />
    <CardTitle>Moon</CardTitle>
  </CardHeader>
  <CardContent>
    <div class="flex items-baseline gap-2">
      <span class="text-3xl font-semibold tabular-nums">{Math.round(moon.illuminationPct)}%</span>
      <span class="text-base font-medium text-muted-foreground">{moon.phaseName}</span>
    </div>
    <p class="mt-0.5 text-sm text-muted-foreground tabular-nums">
      {moon.ageDays.toFixed(1)} days since new · {moon.waxing ? "brightening" : "fading"}
    </p>

    <div class="mt-4 grid grid-cols-2 gap-4 text-sm">
      {
        phases.map((p) => (
          <div>
            <p class="text-muted-foreground">{p.name}</p>
            <p class="font-medium tabular-nums">{dayLabel(p.at)}</p>
            <p class="text-xs text-muted-foreground tabular-nums" data-until={p.at.toISOString()}>
              {untilLabel(p.at, now.getTime())}
            </p>
          </div>
        ))
      }
    </div>
  </CardContent>
</Card>
