---
// Zero-JS 24h trend line for the stat cards. Rendered server-side as a plain
// inline SVG path — no chart library, no client island. The path is a smooth
// Catmull-Rom spline (shared with the WindTrend island via lib/spark.ts) and
// uses a non-scaling stroke, so it stays a clean, even hairline no matter how
// wide the card stretches it.
import { sparkPath } from "@/lib/spark";

interface Props {
  values: (number | null)[];
  color?: string;
  width?: number;
  height?: number;
  class?: string;
}
const { values, color = "currentColor", width = 120, height = 32, class: klass = "" } = Astro.props;

const d = sparkPath(values, { width, height });
---

{
  d && (
    <svg
      class={klass}
      width={width}
      height={height}
      viewBox={`0 0 ${width} ${height}`}
      fill="none"
      aria-hidden="true"
      preserveAspectRatio="none"
    >
      <path
        d={d}
        stroke={color}
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        vector-effect="non-scaling-stroke"
      />
    </svg>
  )
}
