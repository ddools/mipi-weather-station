---
// "Current conditions at a glance" — the headline tile, shown above the tabs so
// it's always visible whichever tab is open. Its own small poll loop keeps it
// live (the detail cards in the "Now in detail" tab poll separately).
import SkyIcon from "@/components/SkyIcon.astro";
import { getLatestReading, getTodaySummary } from "@/lib/supabase";
import { getCurrentSky } from "@/lib/forecast";
import { ageLabel, degToCompass, fmt, msToKmh } from "@/lib/format";
import { feelsLike } from "@/lib/derived";
import { getTideStatus, nextTurn, TIDE_STAGE_LABEL, type TideStatus } from "@/lib/tides";

const [latest, summary, sky, tide] = await Promise.all([
  getLatestReading(),
  getTodaySummary(),
  getCurrentSky(),
  // The tide marker is a nice-to-have — never let the marine API sink the hero.
  getTideStatus().catch(() => null),
]);

const ageSec = latest?.recorded_at
  ? (Date.now() - new Date(latest.recorded_at).getTime()) / 1000
  : Infinity;
// Keep in step with STATUS in the script below. Past "live" the whole status
// chip is tinted, so a stalled feed is obvious and not just a dot changing colour.
const status =
  ageSec <= 180
    ? { key: "live", label: "Live", color: "#10b981", chip: "" }
    : ageSec <= 900
      ? { key: "delayed", label: "Delayed", color: "#f59e0b", chip: "bg-amber-400/25 ring-amber-500/50" }
      : { key: "offline", label: "Station offline", color: "#ef4444", chip: "bg-red-500/20 ring-red-500/50" };

// Offline → the newest row's instantaneous values no longer describe "now".
const reading = status.key === "offline" ? null : latest;

const feels = reading ? feelsLike(reading.temp_c, reading.wind_speed_ms, reading.dewpoint_c) : null;
const windKmh = msToKmh(reading?.wind_speed_ms ?? null);
const isNight = sky?.isDay === false;

const lastUpdatedAbs = latest?.recorded_at
  ? new Date(latest.recorded_at).toLocaleString("en-IE", {
      day: "2-digit",
      month: "short",
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "Europe/Dublin",
    })
  : null;
const lastReadingText = latest?.recorded_at
  ? `last reading ${ageLabel(latest.recorded_at)}`
  : "awaiting first reading";

// Tide marker: "Tide coming in · High 14:32". Slack water already names the
// tide ("High tide"), so only the in/out stages get the "Tide" prefix.
function tideText(t: TideStatus | null) {
  if (!t) return null;
  const label = TIDE_STAGE_LABEL[t.stage];
  const turn = nextTurn(t);
  return {
    stage: t.stage === "rising" || t.stage === "falling" ? `Tide ${label.toLowerCase()}` : label,
    next: turn
      ? `${turn.type === "high" ? "High" : "Low"} ${new Date(turn.time).toLocaleTimeString("en-IE", {
          hour: "2-digit",
          minute: "2-digit",
          timeZone: "Europe/Dublin",
        })}`
      : "",
    up: t.stage === "high" || t.trend === "rising",
  };
}
const tideNow = tideText(tide);

// Lucide waves-arrow-up/-down, inline so they take currentColor (Meteocons' tide
// icons hard-code a dark arrow that vanishes on the night gradient).
const WAVES =
  '<path d="M2 15c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>' +
  '<path d="M2 21c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>';
const TIDE_UP = '<path d="M12 2v8"/><path d="m8 6 4-4 4 4"/>';
const TIDE_DOWN = '<path d="M12 10V2"/><path d="m16 6-4 4-4-4"/>';

const stats = [
  {
    label: "Wind",
    field: "wind_kmh",
    value: windKmh === null ? "N/A" : `${Math.round(windKmh)} km/h`,
    sub: "",
    subField: "wind_dir",
  },
  {
    label: "Humidity",
    field: "humidity",
    value: fmt(reading?.humidity ?? null, 0, "%"),
    sub: "relative",
  },
  {
    label: "Pressure",
    field: "pressure_msl_hpa",
    value: fmt(reading?.pressure_msl_hpa ?? null, 0, " hPa"),
    sub: "at sea level",
  },
  {
    label: "Rain today",
    field: "rain_today",
    value: fmt(summary.rainToday, 1, " mm"),
    sub: "since midnight",
  },
];
---

<div
  id="now-hero"
  data-recorded-at={latest?.recorded_at ?? ""}
  class:list={[
    "relative overflow-hidden rounded-2xl p-6 ring-1 ring-foreground/10 sm:p-8",
    isNight
      ? "bg-gradient-to-br from-indigo-950 via-slate-900 to-slate-950 text-slate-100"
      : "bg-gradient-to-br from-sky-100 via-sky-50 to-amber-50 text-slate-900 dark:from-sky-950 dark:via-slate-900 dark:to-slate-950 dark:text-slate-100",
  ]}
>
  <div class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
    <span
      id="hero-status"
      class:list={[
        "-mx-2 flex items-center gap-2 rounded-full px-2 py-0.5",
        status.chip && `ring-1 ${status.chip}`,
      ]}
      title={lastUpdatedAbs ? `Last reading ${lastUpdatedAbs}` : undefined}
    >
      <span class="flex items-center gap-2 font-medium">
        <span class="relative flex h-2.5 w-2.5">
          <span
            id="hero-ping"
            class:list={[
              "absolute inline-flex h-full w-full rounded-full opacity-75 motion-reduce:hidden",
              { "animate-ping": status.key === "live" },
            ]}
            style={`background-color:${status.color}`}
          ></span>
          <span
            id="hero-dot"
            class="relative inline-flex h-2.5 w-2.5 rounded-full"
            style={`background-color:${status.color}`}
          ></span>
        </span>
        <span id="hero-label">{status.label}</span>
      </span>
      <span id="hero-updated" class="opacity-80 tabular-nums">· {lastReadingText}</span>
    </span>
    <span
      id="hero-tide"
      class:list={["flex items-center gap-1.5 sm:ml-auto", { hidden: !tideNow }]}
    >
      <svg
        class:list={[
          "h-4 w-4 shrink-0",
          isNight ? "text-sky-300" : "text-sky-700 dark:text-sky-300",
        ]}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <g set:html={WAVES} />
        <g data-tide-arrow="up" class:list={{ hidden: tideNow?.up === false }} set:html={TIDE_UP} />
        <g data-tide-arrow="down" class:list={{ hidden: tideNow?.up !== false }} set:html={TIDE_DOWN} />
      </svg>
      <span class="font-medium" data-field="tide_stage">{tideNow?.stage}</span>
      <span class="opacity-80 tabular-nums" data-field="tide_next">
        {tideNow?.next && `· ${tideNow.next}`}
      </span>
    </span>
  </div>

  {/* Stacked (temperature over a 2×2 of stats) until desktop: side by side at
      tablet width, the stats wrapped "1018 hPa" and "RAIN TODAY" onto two lines. */}
  <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
    <div class="flex items-center gap-4 sm:gap-5">
      <SkyIcon
        name={sky?.icon ?? "overcast-day"}
        alt={sky?.label ?? ""}
        animated
        class="h-24 w-24 shrink-0 drop-shadow-sm sm:h-28 sm:w-28"
      />
      <div>
        <div class="flex items-start gap-1">
          <span
            class="text-6xl font-semibold leading-none tabular-nums sm:text-7xl"
            data-field="temp_hero"
          >
            {reading?.temp_c == null ? "—" : reading.temp_c.toFixed(1)}
          </span>
          <span class="mt-1 text-2xl opacity-80 sm:text-3xl">°C</span>
        </div>
        <p class="mt-3 text-xl font-medium">{sky?.label ?? "Current conditions"}</p>
        <p class="mt-1 text-sm opacity-80 tabular-nums">
          <span data-field="feels_hero">
            {feels ? `Feels like ${feels.value.toFixed(1)}°` : "—"}
          </span>
          <span class="mx-1.5" aria-hidden="true">·</span>
          {"High "}<span data-field="temp_max">{fmt(summary.tempMax, 1, "°")}</span>
          {" · Low "}<span data-field="temp_min">{fmt(summary.tempMin, 1, "°")}</span>
          {" today"}
        </p>
      </div>
    </div>

    <dl class="grid grid-cols-2 gap-y-5 lg:grid-cols-4 lg:gap-y-0">
      {
        stats.map((s, i) => (
          <div
            class:list={[
              "px-4 first:pl-0 sm:px-5",
              i > 0 && "border-l border-current/15",
              i === 2 && "border-l-0 pl-0 sm:pl-0 lg:border-l lg:pl-5",
            ]}
          >
            <dt class="text-xs font-medium uppercase tracking-wide opacity-70">{s.label}</dt>
            <dd class="mt-1 text-xl font-semibold tabular-nums sm:text-2xl" data-field={s.field}>
              {s.value}
            </dd>
            <dd class="mt-0.5 text-xs opacity-80 tabular-nums">
              {s.subField ? (
                <>
                  from <span data-field={s.subField}>{degToCompass(reading?.wind_dir_deg ?? null)}</span>
                </>
              ) : (
                s.sub
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>

<script>
  const root = document.getElementById("now-hero");
  if (root) {
    const COMPASS = [
      "N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE",
      "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW",
    ];
    const NO_VALUE = "N/A";

    const num = (v: unknown): number | null =>
      typeof v === "number" && !Number.isNaN(v) ? v : null;
    const fmt = (v: number | null, digits: number, unit: string) =>
      v === null ? NO_VALUE : `${v.toFixed(digits)}${unit}`;
    const kmh = (ms: number | null) => (ms === null ? NO_VALUE : `${Math.round(ms * 3.6)} km/h`);
    const compass = (deg: number | null) =>
      deg === null ? NO_VALUE : COMPASS[Math.round(deg / 22.5) % 16];

    // Mirrors lib/derived.ts (client scripts inline their helpers — no bundler).
    function feelsLike(tC: number | null, ws: number | null, dp: number | null) {
      if (tC === null) return null;
      const windKmh = ws === null ? 0 : Math.max(0, ws) * 3.6;
      if (tC <= 10 && windKmh > 4.8) {
        const v = Math.pow(windKmh, 0.16);
        const wc = 13.12 + 0.6215 * tC - 11.37 * v + 0.3965 * tC * v;
        if (wc < tC - 0.4) return wc;
      }
      if (tC >= 20 && dp !== null) {
        const e = 6.11 * Math.exp(5417.753 * (1 / 273.16 - 1 / (273.15 + dp)));
        const hx = tC + 0.5555 * (e - 10);
        if (hx > tC + 0.4) return hx;
      }
      return tC;
    }

    const set = (field: string, text: string) => {
      const el = root.querySelector(`[data-field="${field}"]`);
      if (el) el.textContent = text;
    };
    const isStale = () => {
      const iso = root.dataset.recordedAt;
      return !iso || (Date.now() - new Date(iso).getTime()) / 1000 > 900;
    };

    // Mirrors `status` in the frontmatter. Chip classes are listed in full so
    // Tailwind keeps them in the build.
    const STATUS = [
      { label: "Live", color: "#10b981", maxAge: 180, ping: true, chip: [] as string[] },
      { label: "Delayed", color: "#f59e0b", maxAge: 900, ping: false,
        chip: ["ring-1", "bg-amber-400/25", "ring-amber-500/50"] },
      { label: "Station offline", color: "#ef4444", maxAge: Infinity, ping: false,
        chip: ["ring-1", "bg-red-500/20", "ring-red-500/50"] },
    ];
    const ALL_CHIP = [...new Set(STATUS.flatMap((s) => s.chip))];
    function fmtAbsolute(iso: string) {
      return new Date(iso).toLocaleString("en-IE", {
        day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit",
        timeZone: "Europe/Dublin",
      });
    }
    // Mirrors lib/format.ts:ageLabel.
    function ageLabel(sec: number) {
      const s = Math.max(0, Math.floor(sec));
      if (s < 60) return `${s}s ago`;
      const mins = Math.floor(s / 60);
      if (mins < 60) return `${mins}m ago`;
      const h = Math.floor(mins / 60);
      if (h < 24) return mins % 60 ? `${h}h ${mins % 60}m ago` : `${h}h ago`;
      const days = Math.floor(h / 24);
      return days === 1 ? "a day ago" : `${days} days ago`;
    }
    function updateStatus(iso: string | undefined) {
      const chip = document.getElementById("hero-status");
      const label = document.getElementById("hero-label");
      const dot = document.getElementById("hero-dot");
      const ping = document.getElementById("hero-ping");
      const updated = document.getElementById("hero-updated");
      if (!chip || !label || !dot || !ping || !updated) return;
      const age = iso ? (Date.now() - new Date(iso).getTime()) / 1000 : Infinity;
      const s = STATUS.find((x) => age <= x.maxAge)!;
      label.textContent = s.label;
      dot.style.backgroundColor = ping.style.backgroundColor = s.color;
      ping.classList.toggle("animate-ping", s.ping);
      chip.classList.remove(...ALL_CHIP);
      chip.classList.add(...s.chip);
      updated.textContent = iso ? `· last reading ${ageLabel(age)}` : "· awaiting first reading";
      if (iso) chip.title = `Last reading ${fmtAbsolute(iso)}`;
    }

    const refreshCurrent = async () => {
      try {
        const res = await fetch("/api/current");
        if (!res.ok) return;
        const reading = await res.json();
        if (!reading) return;
        root.dataset.recordedAt = reading.recorded_at;
        const stale = isStale();
        const temp = stale ? null : num(reading.temp_c);
        const windMs = stale ? null : num(reading.wind_speed_ms);
        const dir = stale ? null : num(reading.wind_dir_deg);
        const dewpoint = stale ? null : num(reading.dewpoint_c);

        set("temp_hero", temp === null ? "—" : temp.toFixed(1));
        const f = stale ? null : feelsLike(temp, windMs, dewpoint);
        set("feels_hero", f === null ? "—" : `Feels like ${f.toFixed(1)}°`);
        set("wind_kmh", kmh(windMs));
        set("wind_dir", compass(dir));
        set("humidity", fmt(stale ? null : num(reading.humidity), 0, "%"));
        set("pressure_msl_hpa", fmt(stale ? null : num(reading.pressure_msl_hpa), 0, " hPa"));
        updateStatus(reading.recorded_at);
      } catch {
        /* next interval retries */
      }
    };

    const refreshSummary = async () => {
      try {
        const res = await fetch("/api/summary");
        if (!res.ok) return;
        const s = await res.json();
        set("temp_max", fmt(num(s.tempMax), 1, "°"));
        set("temp_min", fmt(num(s.tempMin), 1, "°"));
        set("rain_today", fmt(num(s.rainToday), 1, " mm"));
      } catch {
        /* next interval retries */
      }
    };

    // Mirrors lib/tides.ts (TIDE_STAGE_LABEL / nextTurn) and tideText() above.
    const TIDE_STAGE: Record<string, string> = {
      high: "High tide",
      low: "Low tide",
      rising: "Tide coming in",
      falling: "Tide going out",
    };
    const refreshTide = async () => {
      const box = document.getElementById("hero-tide");
      try {
        const res = await fetch("/api/tides");
        if (!res.ok || !box) return;
        const t = await res.json();
        if (!t || !TIDE_STAGE[t.stage]) return;
        const turn = t.trend === "rising" ? t.nextHigh : t.nextLow;
        set("tide_stage", TIDE_STAGE[t.stage]);
        set(
          "tide_next",
          turn
            ? `· ${turn.type === "high" ? "High" : "Low"} ${new Date(turn.time).toLocaleTimeString(
                "en-IE",
                { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Dublin" },
              )}`
            : "",
        );
        const up = t.stage === "high" || t.trend === "rising";
        box.querySelector('[data-tide-arrow="up"]')?.classList.toggle("hidden", !up);
        box.querySelector('[data-tide-arrow="down"]')?.classList.toggle("hidden", up);
        box.classList.remove("hidden");
      } catch {
        /* next interval retries */
      }
    };

    updateStatus(root.dataset.recordedAt || undefined);
    refreshCurrent();
    setInterval(() => updateStatus(root.dataset.recordedAt || undefined), 5_000);
    setInterval(refreshCurrent, 45_000);
    setInterval(refreshSummary, 5 * 60_000);
    setInterval(refreshTide, 10 * 60_000);
  }
</script>
