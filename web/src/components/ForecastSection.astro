---
import { Card, CardContent } from "@/components/ui/card";
import { getForecast } from "@/lib/forecast";
import { degToCompass } from "@/lib/format";
import SkyIcon from "@/components/SkyIcon.astro";

const days = await getForecast();

function temp(v: number | null): string {
  return v === null ? "—" : `${Math.round(v)}°`;
}
---

<Card>
  <CardContent>
    <div class="mb-4 flex items-baseline justify-between">
      <h3 class="text-base font-semibold">5-day forecast</h3>
      <span class="text-xs text-muted-foreground">Skerries</span>
    </div>

    {
      !days ? (
        <p class="text-sm text-muted-foreground">Forecast unavailable right now.</p>
      ) : (
        <>
          <ol class="grid grid-cols-2 gap-x-3 gap-y-5 sm:grid-cols-3 lg:grid-cols-5">
            {days.map((d, i) => (
              <li
                class:list={[
                  "flex flex-col items-center rounded-lg px-3 py-2 text-center",
                  i === 0 && "bg-muted/60 ring-1 ring-border",
                ]}
              >
                <span class="text-sm font-medium">{d.weekday}</span>
                <SkyIcon name={d.icon} alt={d.label} class="my-1 h-14 w-14" />
                <span class="text-xs text-muted-foreground">{d.label}</span>
                <span class="mt-1.5 tabular-nums">
                  <span class="font-semibold">{temp(d.tempMax)}</span>
                  <span class="mx-1 text-muted-foreground" aria-hidden="true">/</span>
                  <span class="text-muted-foreground">{temp(d.tempMin)}</span>
                </span>
                <span class="sr-only">
                  high {temp(d.tempMax)}, low {temp(d.tempMin)}
                </span>

                {/* "3.4 mm · 62%" gave two unlabelled numbers in two different
                    units. Name them: what falls, and how likely it is. */}
                <dl class="mx-auto mt-2 w-full max-w-40 space-y-0.5 text-xs text-muted-foreground tabular-nums">
                  <div class="flex justify-between gap-2">
                    <dt>Rain</dt>
                    <dd class="font-medium text-foreground/80">
                      {d.precipMm !== null && d.precipMm >= 0.1
                        ? `${d.precipMm.toFixed(1)} mm`
                        : "none"}
                    </dd>
                  </div>
                  <div class="flex justify-between gap-2">
                    <dt>Chance</dt>
                    <dd class="font-medium text-foreground/80">
                      {d.precipProbPct === null ? "—" : `${Math.round(d.precipProbPct)}%`}
                    </dd>
                  </div>
                  <div class="flex justify-between gap-2">
                    <dt>Wind</dt>
                    <dd class="font-medium text-foreground/80">
                      {d.windMaxKmh === null
                        ? "—"
                        : `${Math.round(d.windMaxKmh)} km/h ${degToCompass(d.windDirDeg)}`}
                    </dd>
                  </div>
                </dl>
              </li>
            ))}
          </ol>
          <p class="mt-4 text-xs text-muted-foreground">Forecast: Open-Meteo · updates hourly</p>
        </>
      )
    }
  </CardContent>
</Card>
