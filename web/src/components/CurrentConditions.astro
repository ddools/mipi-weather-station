---
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import Sparkline from "@/components/Sparkline.astro";
import { WindTrend } from "@/components/WindTrend";
import { getLatestReading, getTodaySummary } from "@/lib/supabase";
import { degToCompass, fmt, beaufort, msToKmh, pressureTrend, trend as changeTrend } from "@/lib/format";
import { feelsLike, dewPointComfort } from "@/lib/derived";
import { airQualityBand, type AirBand } from "@/lib/air";
import thermometerIcon from "@meteocons/svg/flat/thermometer.svg?url";
import humidityIcon from "@meteocons/svg/flat/humidity.svg?url";
import pressureHighIcon from "@meteocons/svg/flat/pressure-high.svg?url";
import pressureLowIcon from "@meteocons/svg/flat/pressure-low.svg?url";
import pressureNoneIcon from "@meteocons/svg/flat/barometer.svg?url";
import windIcon from "@meteocons/svg/flat/wind.svg?url";
import rainIcon from "@meteocons/svg/flat/rain.svg?url";
import airQualityIcon from "@meteocons/svg/flat/smoke-particles.svg?url";
import compassSvgRaw from "@meteocons/svg/flat/compass.svg?raw";

const [latestReading, summary] = await Promise.all([getLatestReading(), getTodaySummary()]);

// Live-data status from the age of the newest reading. The collector archives
// every ~60s, so anything within a few minutes is "live"; a longer gap means
// the Pi or its uplink is down. The visible status badge lives in the NowHero
// tile above the tabs; here `status` only gates whether stale values show as N/A.
function liveStatus(iso: string | null | undefined) {
  if (!iso) return { key: "offline" as const, label: "Offline" };
  const age = (Date.now() - new Date(iso).getTime()) / 1000;
  if (age <= 180) return { key: "live" as const, label: "Live" };
  if (age <= 900) return { key: "delayed" as const, label: "Delayed" };
  return { key: "offline" as const, label: "Offline" };
}
const status = liveStatus(latestReading?.recorded_at);

// Once the station is offline the newest row is stale — its instantaneous
// readings (temp, wind, pressure now, …) no longer describe current conditions,
// so we show N/A rather than a frozen number. The "today so far" figures from
// `summary` (H/L, rain, max gust) stay — they're valid history for the day.

// Floor for the rain sparkline's y-domain. The curve is an accumulation, so
// fitting it to its own extent would stretch a single 0.28 mm bucket tip across
// the full height and make a trace of drizzle look like a downpour. Anything up
// to a light shower stays visibly flat against this; wetter days scale past it.
const RAIN_SPARK_MIN_MM = 2;
const reading = status.key === "offline" ? null : latestReading;

const pressureHpa = reading?.pressure_msl_hpa ?? null;
const pressureIcon =
  pressureHpa === null
    ? pressureNoneIcon
    : pressureHpa >= 1013
      ? pressureHighIcon
      : pressureLowIcon;

const trend = reading ? pressureTrend(summary.pressureNow, summary.pressure3hAgo) : null;

// Temperature: hourly-rate trend arrow + change since the same time yesterday.
const tempTrend = reading ? changeTrend(summary.tempNow, summary.temp1hAgo, 0.3) : null;
const tempVs24h = reading ? changeTrend(summary.tempNow, summary.temp24hAgo, 0.5) : null;
const humidityTrend = reading ? changeTrend(summary.humidityNow, summary.humidity1hAgo, 2) : null;

// "Feels like" apparent temperature and dew-point comfort.
const feels = reading
  ? feelsLike(reading.temp_c, reading.wind_speed_ms, reading.dewpoint_c)
  : null;
const comfort = dewPointComfort(reading?.dewpoint_c ?? null);

function humidityNote(rh: number | null | undefined): string {
  if (rh == null) return "relative humidity";
  if (rh >= 90) return "very damp air";
  if (rh <= 45) return "dry air";
  return "relative humidity";
}

const air = airQualityBand(reading?.air_quality);
const AIR_STYLE: Record<AirBand, { dot: string; text: string }> = {
  good: { dot: "bg-emerald-500", text: "text-emerald-600 dark:text-emerald-400" },
  moderate: { dot: "bg-amber-500", text: "text-amber-600 dark:text-amber-400" },
  poor: { dot: "bg-red-500", text: "text-red-600 dark:text-red-400" },
  unknown: { dot: "bg-muted-foreground/40", text: "text-muted-foreground" },
};

const bft = beaufort(reading?.wind_speed_ms ?? null);
const windKmh = msToKmh(reading?.wind_speed_ms ?? null);
const gustKmh = msToKmh(reading?.wind_gust_ms ?? null);
const gustMaxKmh = msToKmh(summary.gustMax);

// The compass icon's needle is a separate <g id="Pointer"> group with its own
// idle wobble animation (SMIL animateTransform, rotate -6..6deg). We point it
// at the real wind direction by injecting a static base rotation and marking
// the wobble `additive="sum"` so the two combine instead of the wobble
// overwriting our rotation every frame. Falls back to the icon's default
// (unrotated, still wobbling) if either anchor string isn't found — e.g. a
// future meteocons release changes the internal markup.
function renderCompass(deg: number | null): string {
  const sized = compassSvgRaw.replace("<svg ", '<svg width="100%" height="100%" ');
  if (deg === null) return sized;
  return sized
    .replace('<g id="Pointer">', `<g id="Pointer" transform="rotate(${Math.round(deg)} 64 64)">`)
    .replace(
      'type="rotate" values="-6 64 64;6 64 64;-6 64 64"',
      'type="rotate" values="-6 64 64;6 64 64;-6 64 64" additive="sum"'
    );
}

const compassSvg = renderCompass(reading?.wind_dir_deg ?? null);
const rainSparkDomain: [number, number] = [
  0,
  Math.max(summary.rainToday ?? 0, RAIN_SPARK_MIN_MM),
];

// A sparkline auto-scales to its own extent, so the same shape can mean a 0.4°
// wobble or a 12° swing. Print the range it is drawn against underneath, or the
// line is decoration rather than data.
function sparkRange(values: (number | null)[], digits: number, unit: string): string | null {
  const nums = values.filter((v): v is number => v !== null && !Number.isNaN(v));
  if (nums.length < 2) return null;
  const lo = Math.min(...nums);
  const hi = Math.max(...nums);
  if (hi - lo < Math.pow(10, -digits)) return `steady at ${lo.toFixed(digits)}${unit}`;
  return `${lo.toFixed(digits)} – ${hi.toFixed(digits)}${unit}`;
}
const tempSparkRange = sparkRange(summary.spark.temp, 1, "°C");
const pressureSparkRange = sparkRange(summary.spark.pressure, 0, " hPa");
const humiditySparkRange = sparkRange(summary.spark.humidity, 0, "%");
const windSparkRange = sparkRange(
  summary.spark.wind.map((v) => (v === null ? null : v * 3.6)),
  0,
  " km/h"
);

---

<div
  id="current-conditions"
  data-recorded-at={latestReading?.recorded_at ?? ""}
  data-wind-dir-deg={reading?.wind_dir_deg ?? ""}
>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <Card>
      <CardHeader className="flex items-center gap-2">
        <img src={thermometerIcon} alt="" class="h-10 w-10" />
        <CardTitle>Temperature</CardTitle>
      </CardHeader>
      <CardContent className="flex flex-1 flex-col">
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-semibold tabular-nums" data-field="temp_c">
            {fmt(reading?.temp_c ?? null, 1, "°C")}
          </span>
          <span class="text-sm text-muted-foreground tabular-nums" data-field="temp_trend">
            {tempTrend && tempTrend.key !== "flat"
              ? `${tempTrend.arrow} ${Math.abs(tempTrend.delta).toFixed(1)}°/h`
              : ""}
          </span>
        </div>
        <dl class="mt-3 grid grid-cols-3 gap-2 text-sm tabular-nums">
          <div>
            <dt class="text-xs text-muted-foreground">High today</dt>
            <dd class="font-medium" data-field="temp_max">{fmt(summary.tempMax, 1, "°")}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted-foreground">Low today</dt>
            <dd class="font-medium" data-field="temp_min">{fmt(summary.tempMin, 1, "°")}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted-foreground">vs 24h ago</dt>
            <dd class="font-medium" data-field="temp_vs_24h">
              {tempVs24h && tempVs24h.key !== "flat"
                ? `${tempVs24h.delta > 0 ? "+" : "−"}${Math.abs(tempVs24h.delta).toFixed(1)}°`
                : "about the same"}
            </dd>
          </div>
        </dl>

        <dl class="mt-3 border-t border-border/60 pt-3 text-sm">
          <div class="flex items-baseline justify-between gap-2">
            <dt class="text-muted-foreground">Feels like</dt>
            <dd class="tabular-nums" data-field="feels_like">
              {feels ? `${feels.value.toFixed(1)}°C` : "N/A"}
            </dd>
          </div>
          <p class="mt-0.5 text-xs text-muted-foreground" data-field="feels_caption">
            {feels ? feels.caption : "apparent temperature"}
          </p>
          <div class="mt-2 flex items-baseline justify-between gap-2">
            <dt class="text-muted-foreground">Dew point</dt>
            <dd class="tabular-nums" data-field="dewpoint_c">
              {fmt(reading?.dewpoint_c ?? null, 1, "°C")}
            </dd>
          </div>
          <p class="mt-0.5 text-xs text-muted-foreground" data-field="dewpoint_comfort">
            {comfort ? `air feels ${comfort}` : "humidity comfort"}
          </p>
        </dl>

        <div class="mt-auto pt-4">
          <Sparkline
            values={summary.spark.temp}
            color="#ef4444"
            class="w-full text-muted-foreground/60"
          />
          <p class="mt-1 flex justify-between text-xs text-muted-foreground tabular-nums">
            <span>Last 24 hours</span>
            <span>{tempSparkRange}</span>
          </p>
        </div>
      </CardContent>
    </Card>

    <Card>
      <CardHeader className="flex items-center gap-2">
        <img src={rainIcon} alt="" class="h-10 w-10" />
        <CardTitle>Rain today</CardTitle>
      </CardHeader>
      <CardContent className="flex flex-1 flex-col">
        <div class="text-3xl font-semibold tabular-nums" data-field="rain_today">
          {fmt(summary.rainToday, 1, " mm")}
        </div>
        <p class="mt-1 text-sm text-muted-foreground">since midnight</p>

        <dl class="mt-3 grid grid-cols-2 gap-2 text-sm tabular-nums">
          <div>
            <dt class="text-xs text-muted-foreground">Last hour</dt>
            <dd class="font-medium" data-field="rain_last_hour">
              {fmt(summary.rainLastHour, 1, " mm")}
            </dd>
          </div>
          <div>
            <dt class="text-xs text-muted-foreground">Last 24 hours</dt>
            <dd class="font-medium" data-field="rain_24h">{fmt(summary.rain24h, 1, " mm")}</dd>
          </div>
        </dl>

        <div class="mt-auto pt-4">
          <Sparkline
            values={summary.spark.rain}
            domain={rainSparkDomain}
            color="#38bdf8"
            class="w-full text-muted-foreground/60"
          />
          <p class="mt-1 flex justify-between text-xs text-muted-foreground tabular-nums">
            <span>Running total today</span>
            <span data-field="rain_today_spark">{fmt(summary.rainToday, 1, " mm")}</span>
          </p>
        </div>
      </CardContent>
    </Card>

    <Card className="lg:col-span-2">
      <CardHeader className="flex items-center gap-2">
        <img src={windIcon} alt="" class="h-10 w-10" />
        <CardTitle>Wind</CardTitle>
      </CardHeader>
      <CardContent className="flex flex-wrap items-center gap-x-8 gap-y-4">
        <div class="flex items-center gap-4">
          <div id="wind-compass" class="h-32 w-32 shrink-0" set:html={compassSvg} />
          <div>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-semibold tabular-nums" data-field="wind_kmh">
                {windKmh === null ? "N/A" : `${Math.round(windKmh)} km/h`}
              </span>
              <span class="text-sm text-muted-foreground tabular-nums" data-field="wind_ms">
                {fmt(reading?.wind_speed_ms ?? null, 1, " m/s")}
              </span>
            </div>
            <p class="mt-1 text-sm text-muted-foreground" data-field="wind_beaufort">
              {bft ? `Force ${bft.force} · ${bft.label}` : "N/A"}
            </p>
          </div>
        </div>
        <dl class="text-sm text-muted-foreground tabular-nums">
          <div class="flex gap-2">
            <dt class="w-32 shrink-0">Gust now</dt>
            <dd data-field="wind_gust_kmh">
              {gustKmh === null ? "N/A" : `${Math.round(gustKmh)} km/h`}
            </dd>
          </div>
          <div class="mt-1 flex gap-2">
            <dt class="w-32 shrink-0">Max gust today</dt>
            <dd data-field="wind_gust_max_kmh">
              {gustMaxKmh === null ? "N/A" : `${Math.round(gustMaxKmh)} km/h`}
            </dd>
          </div>
          <div class="mt-1 flex gap-2">
            <dt class="w-32 shrink-0">Direction</dt>
            <dd>
              from <span data-field="wind_dir"
                >{degToCompass(reading?.wind_dir_deg ?? null)}</span
              > <span data-field="wind_dir_deg"
                >{reading?.wind_dir_deg == null ? "(N/A)" : `(${reading.wind_dir_deg}°)`}</span
              >
            </dd>
          </div>
        </dl>
        <WindTrend client:load />
        <div class="mt-1 basis-full">
          <Sparkline
            values={summary.spark.wind}
            color="#10b981"
            height={28}
            class="w-full text-muted-foreground/60"
          />
          <p class="mt-1 flex justify-between text-xs text-muted-foreground tabular-nums">
            <span>Last 24 hours</span>
            <span>{windSparkRange}</span>
          </p>
        </div>
      </CardContent>
    </Card>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <Card>
      <CardHeader className="flex items-center gap-2">
        <img src={pressureIcon} alt="" class="h-10 w-10" />
        <CardTitle>Pressure</CardTitle>
      </CardHeader>
      <CardContent className="flex flex-1 flex-col">
        <div class="text-3xl font-semibold tabular-nums" data-field="pressure_msl_hpa">
          {fmt(reading?.pressure_msl_hpa ?? null, 0, " hPa")}
        </div>
        <p class="mt-2 text-sm text-muted-foreground tabular-nums" id="pressure-trend">
          {
            trend
              ? `${trend.arrow} ${trend.label} ${Math.abs(trend.deltaHpa).toFixed(1)} hPa / 3h`
              : "sea-level adjusted"
          }
        </p>
        <div class="mt-auto pt-4">
          <Sparkline
            values={summary.spark.pressure}
            color="#8b5cf6"
            class="w-full text-muted-foreground/60"
          />
          <p class="mt-1 flex justify-between text-xs text-muted-foreground tabular-nums">
            <span>Last 24 hours</span>
            <span>{pressureSparkRange}</span>
          </p>
        </div>
      </CardContent>
    </Card>

    <Card>
      <CardHeader className="flex items-center gap-2">
        <img src={humidityIcon} alt="" class="h-10 w-10" />
        <CardTitle>Humidity</CardTitle>
      </CardHeader>
      <CardContent className="flex flex-1 flex-col">
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-semibold tabular-nums" data-field="humidity">
            {fmt(reading?.humidity ?? null, 0, "%")}
          </span>
          <span class="text-sm text-muted-foreground tabular-nums" data-field="humidity_trend">
            {humidityTrend && humidityTrend.key !== "flat"
              ? `${humidityTrend.arrow} ${Math.abs(humidityTrend.delta).toFixed(0)}%/h`
              : ""}
          </span>
        </div>
        <p class="mt-2 text-sm text-muted-foreground" data-field="humidity_note">
          {humidityNote(reading?.humidity)}
        </p>
        <div class="mt-auto pt-4">
          <Sparkline
            values={summary.spark.humidity}
            color="#3b82f6"
            class="w-full text-muted-foreground/60"
          />
          <p class="mt-1 flex justify-between text-xs text-muted-foreground tabular-nums">
            <span>Last 24 hours</span>
            <span>{humiditySparkRange}</span>
          </p>
        </div>
      </CardContent>
    </Card>

    {
      reading?.air_quality != null && (
        <Card>
          <CardHeader className="flex items-center gap-2">
            <img src={airQualityIcon} alt="" class="h-10 w-10" />
            <CardTitle>Air quality</CardTitle>
          </CardHeader>
          <CardContent>
            <div class="flex items-center gap-2.5">
              <span
                data-field="air_dot"
                class={`inline-block h-3 w-3 shrink-0 rounded-full ${AIR_STYLE[air.band].dot}`}
              />
              <span
                data-field="air_quality"
                class={`text-2xl font-semibold ${AIR_STYLE[air.band].text}`}
              >
                {air.label}
              </span>
            </div>
            <p class="mt-2 text-sm text-muted-foreground" data-field="air_note">{air.note}</p>
          </CardContent>
        </Card>
      )
    }
  </div>
</div>

<script>
  const COMPASS = [
    "N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE",
    "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW",
  ];

  const BEAUFORT = [
    [0.5, 0, "Calm"], [1.5, 1, "Light air"], [3.3, 2, "Light breeze"],
    [5.5, 3, "Gentle breeze"], [7.9, 4, "Moderate breeze"], [10.7, 5, "Fresh breeze"],
    [13.8, 6, "Strong breeze"], [17.1, 7, "Near gale"], [20.7, 8, "Gale"],
    [24.4, 9, "Strong gale"], [28.4, 10, "Storm"], [32.6, 11, "Violent storm"],
    [Infinity, 12, "Hurricane force"],
  ] as const;

  function num(value: unknown): number | null {
    return typeof value === "number" && !Number.isNaN(value) ? value : null;
  }
  const NO_VALUE = "N/A";
  function fmt(value: number | null, digits: number, unit: string) {
    return value === null ? NO_VALUE : `${value.toFixed(digits)}${unit}`;
  }
  function kmh(ms: number | null) {
    return ms === null ? NO_VALUE : `${Math.round(ms * 3.6)} km/h`;
  }
  function beaufort(ms: number | null) {
    if (ms === null) return NO_VALUE;
    const b = BEAUFORT.find(([maxMs]) => ms < maxMs) ?? BEAUFORT[BEAUFORT.length - 1];
    return `Force ${b[1]} · ${b[2]}`;
  }
  function compass(deg: number | null) {
    return deg === null ? NO_VALUE : COMPASS[Math.round(deg / 22.5) % 16];
  }

  // Mirrors lib/derived.ts — the client script inlines its helpers (no bundler).
  function feelsLike(tC: number | null, ws: number | null, dp: number | null) {
    if (tC === null) return null;
    const windKmh = ws === null ? 0 : Math.max(0, ws) * 3.6;
    if (tC <= 10 && windKmh > 4.8) {
      const v = Math.pow(windKmh, 0.16);
      const wc = 13.12 + 0.6215 * tC - 11.37 * v + 0.3965 * tC * v;
      if (wc < tC - 0.4) return { value: wc, caption: "wind chill" };
    }
    if (tC >= 20 && dp !== null) {
      const e = 6.11 * Math.exp(5417.753 * (1 / 273.16 - 1 / (273.15 + dp)));
      const hx = tC + 0.5555 * (e - 10);
      if (hx > tC + 0.4) return { value: hx, caption: "humidity making it feel warmer" };
    }
    return { value: tC, caption: "same as the air temperature" };
  }
  const DEWPOINT_BANDS: [number, string][] = [
    [10, "dry"], [13, "comfortable"], [16, "becoming sticky"],
    [18, "humid"], [21, "very humid"], [Infinity, "oppressive"],
  ];
  function dewComfort(dp: number | null) {
    if (dp === null) return null;
    return (DEWPOINT_BANDS.find(([max]) => dp < max) ?? DEWPOINT_BANDS[DEWPOINT_BANDS.length - 1])[1];
  }

  // Mirrors lib/air.ts. Class lists must match the AIR_STYLE map in the frontmatter
  // so Tailwind keeps them in the build.
  const AIR_BANDS = [
    { max: 63, label: "Good", note: "nothing unusual in the air",
      dot: "bg-emerald-500", text: ["text-emerald-600", "dark:text-emerald-400"] },
    { max: 64.5, label: "Moderate", note: "slightly raised — cooking or solvents nearby",
      dot: "bg-amber-500", text: ["text-amber-600", "dark:text-amber-400"] },
    { max: Infinity, label: "Poor", note: "raised — a strong nearby source",
      dot: "bg-red-500", text: ["text-red-600", "dark:text-red-400"] },
  ];
  const AIR_UNKNOWN = { label: "—", note: "sensor warming up", dot: "bg-muted-foreground/40", text: ["text-muted-foreground"] };
  const ALL_AIR_DOTS = ["bg-emerald-500", "bg-amber-500", "bg-red-500", "bg-muted-foreground/40"];
  const ALL_AIR_TEXT = [
    "text-emerald-600", "dark:text-emerald-400", "text-amber-600", "dark:text-amber-400",
    "text-red-600", "dark:text-red-400", "text-muted-foreground",
  ];
  function setAirQuality(v: number | null) {
    const b = v === null ? AIR_UNKNOWN : (AIR_BANDS.find((x) => v <= x.max) ?? AIR_BANDS[2]);
    set("air_quality", b.label);
    set("air_note", b.note);
    const dot = root()?.querySelector('[data-field="air_dot"]');
    const label = root()?.querySelector('[data-field="air_quality"]');
    ALL_AIR_DOTS.forEach((c) => dot?.classList.remove(c));
    dot?.classList.add(b.dot);
    ALL_AIR_TEXT.forEach((c) => label?.classList.remove(c));
    b.text.forEach((c) => label?.classList.add(c));
  }
  function changeArrow(now: number | null, past: number | null, band: number) {
    if (now === null || past === null) return null;
    const delta = now - past;
    const mag = Math.abs(delta);
    if (mag <= band) return { key: "flat", arrow: "→", delta };
    const steep = mag > band * 3;
    return { key: delta > 0 ? "up" : "down", arrow: delta > 0 ? (steep ? "↑" : "↗") : (steep ? "↓" : "↘"), delta };
  }

  const root = () => document.getElementById("current-conditions");
  // The newest row is "stale" once it's over 15 min old — the station is offline
  // and its instantaneous readings no longer describe current conditions.
  function isStale(): boolean {
    const iso = root()?.dataset.recordedAt;
    if (!iso) return true;
    return (Date.now() - new Date(iso).getTime()) / 1000 > 900;
  }
  const set = (field: string, text: string) => {
    const el = root()?.querySelector(`[data-field="${field}"]`);
    if (el) el.textContent = text;
  };

  async function refreshCurrent() {
    try {
      const res = await fetch("/api/current");
      if (!res.ok) return;
      const reading = await res.json();
      if (!reading) return;

      const el = root();
      if (!el) return;
      el.dataset.recordedAt = reading.recorded_at;

      // Offline (>15 min old) means the newest row is stale — its instantaneous
      // readings no longer describe now, so blank them rather than freeze a number.
      const stale = isStale();

      el.dataset.windDirDeg = stale ? "" : reading.wind_dir_deg ?? "";

      const temp = stale ? null : num(reading.temp_c);
      const windMs = stale ? null : num(reading.wind_speed_ms);
      const gustMs = stale ? null : num(reading.wind_gust_ms);
      const dir = stale ? null : num(reading.wind_dir_deg);

      const dewpoint = stale ? null : num(reading.dewpoint_c);
      const humidity = stale ? null : num(reading.humidity);

      set("temp_c", fmt(temp, 1, "°C"));
      set("dewpoint_c", fmt(dewpoint, 1, "°C"));
      set("humidity", fmt(humidity, 0, "%"));
      set("pressure_msl_hpa", fmt(stale ? null : num(reading.pressure_msl_hpa), 0, " hPa"));

      const feels = stale ? null : feelsLike(temp, windMs, dewpoint);
      set("feels_like", feels ? `${feels.value.toFixed(1)}°C` : NO_VALUE);
      set("feels_caption", feels ? feels.caption : "apparent temperature");
      const comfort = dewComfort(dewpoint);
      set("dewpoint_comfort", comfort ? `air feels ${comfort}` : "humidity comfort");
      set(
        "humidity_note",
        humidity === null
          ? "relative humidity"
          : humidity >= 90
            ? "very damp air"
            : humidity <= 45
              ? "dry air"
              : "relative humidity"
      );
      setAirQuality(stale ? null : num(reading.air_quality));
      set("wind_kmh", kmh(windMs));
      set("wind_ms", fmt(windMs, 1, " m/s"));
      set("wind_beaufort", beaufort(windMs));
      set("wind_gust_kmh", kmh(gustMs));
      set("wind_dir", compass(dir));
      set("wind_dir_deg", dir === null ? "(N/A)" : `(${Math.round(dir)}°)`);

      const pointer = document.querySelector("#wind-compass #Pointer");
      if (dir !== null) {
        pointer?.setAttribute("transform", `rotate(${Math.round(dir)} 64 64)`);
      } else {
        pointer?.removeAttribute("transform");
      }
      document.title =
        temp !== null
          ? `${Math.round(temp)}° · Skerries Weather Station`
          : "Skerries Weather Station";
    } catch {
      // network hiccup — next interval will retry
    }
  }

  async function refreshSummary() {
    try {
      const res = await fetch("/api/summary");
      if (!res.ok) return;
      const s = await res.json();

      set("temp_max", fmt(num(s.tempMax), 1, "°"));
      set("temp_min", fmt(num(s.tempMin), 1, "°"));
      set("wind_gust_max_kmh", kmh(num(s.gustMax)));
      set("rain_today", fmt(num(s.rainToday), 1, " mm"));
      set("rain_today_spark", fmt(num(s.rainToday), 1, " mm"));
      set("rain_last_hour", fmt(num(s.rainLastHour), 1, " mm"));
      set("rain_24h", fmt(num(s.rain24h), 1, " mm"));

      const stale = isStale();
      const tempNow = stale ? null : num(s.tempNow);
      const tt = changeArrow(tempNow, num(s.temp1hAgo), 0.3);
      set("temp_trend", tt && tt.key !== "flat" ? `${tt.arrow} ${Math.abs(tt.delta).toFixed(1)}°/h` : "");
      const tv = changeArrow(tempNow, num(s.temp24hAgo), 0.5);
      set(
        "temp_vs_24h",
        tv && tv.key !== "flat"
          ? `${tv.delta > 0 ? "+" : "−"}${Math.abs(tv.delta).toFixed(1)}°`
          : "about the same"
      );
      const ht = changeArrow(stale ? null : num(s.humidityNow), num(s.humidity1hAgo), 2);
      set("humidity_trend", ht && ht.key !== "flat" ? `${ht.arrow} ${Math.abs(ht.delta).toFixed(0)}%/h` : "");

      // Trend leans on "pressure now" — meaningless once the station is offline.
      const now = isStale() ? null : num(s.pressureNow);
      const past = num(s.pressure3hAgo);
      const trendEl = document.getElementById("pressure-trend");
      if (trendEl) {
        if (now !== null && past !== null) {
          const delta = now - past;
          const arrow = delta > 0.5 ? "↑" : delta < -0.5 ? "↓" : "→";
          const label = delta > 0.5 ? "rising" : delta < -0.5 ? "falling" : "steady";
          trendEl.textContent = `${arrow} ${label} ${Math.abs(delta).toFixed(1)} hPa / 3h`;
        } else {
          trendEl.textContent = "sea-level adjusted";
        }
      }
    } catch {
      // ignore — next interval retries
    }
  }

  refreshCurrent(); // sets the tab title and reconciles any drift since SSR
  setInterval(refreshCurrent, 45_000);
  setInterval(refreshSummary, 5 * 60_000);
</script>
