---
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { getLatestReading } from "@/lib/supabase";
import { degToCompass, fmt } from "@/lib/format";
import thermometerIcon from "@meteocons/svg/flat/thermometer.svg?url";
import humidityIcon from "@meteocons/svg/flat/humidity.svg?url";
import pressureHighIcon from "@meteocons/svg/flat/pressure-high.svg?url";
import pressureLowIcon from "@meteocons/svg/flat/pressure-low.svg?url";
import windIcon from "@meteocons/svg/flat/wind.svg?url";
import rainIcon from "@meteocons/svg/flat/rain.svg?url";
import compassIcon from "@meteocons/svg/flat/compass.svg?url";
import compassSvgRaw from "@meteocons/svg/flat/compass.svg?raw";

const reading = await getLatestReading();
const pressureIcon =
  (reading?.pressure_msl_hpa ?? 1013) >= 1013 ? pressureHighIcon : pressureLowIcon;

// The compass icon's needle is a separate <g id="Pointer"> group with its own
// idle wobble animation (SMIL animateTransform, rotate -6..6deg). We point it
// at the real wind direction by injecting a static base rotation and marking
// the wobble `additive="sum"` so the two combine instead of the wobble
// overwriting our rotation every frame. Falls back to the icon's default
// (unrotated, still wobbling) if either anchor string isn't found — e.g. a
// future meteocons release changes the internal markup.
function renderCompass(deg: number | null): string {
  const sized = compassSvgRaw.replace("<svg ", '<svg width="100%" height="100%" ');
  if (deg === null) return sized;
  return sized
    .replace('<g id="Pointer">', `<g id="Pointer" transform="rotate(${Math.round(deg)} 64 64)">`)
    .replace(
      'type="rotate" values="-6 64 64;6 64 64;-6 64 64"',
      'type="rotate" values="-6 64 64;6 64 64;-6 64 64" additive="sum"'
    );
}

const compassSvg = renderCompass(reading?.wind_dir_deg ?? null);
---

<div id="current-conditions" data-recorded-at={reading?.recorded_at ?? ""}>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <Card>
      <CardHeader className="flex items-center gap-2">
        <img src={thermometerIcon} alt="" class="h-10 w-10" />
        <CardTitle>Temperature</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="text-3xl font-semibold tabular-nums" data-field="temp_c">
          {fmt(reading?.temp_c ?? null, 1, "°C")}
        </div>
        <p class="mt-2 text-sm text-muted-foreground">
          Dewpoint <span data-field="dewpoint_c">{fmt(reading?.dewpoint_c ?? null, 1, "°C")}</span>
        </p>
        <p class="mt-1 text-xs text-muted-foreground" data-field="updated" id="updated-label">
          updated —
        </p>
      </CardContent>
    </Card>

    <Card>
      <CardHeader className="flex items-center gap-2">
        <img src={humidityIcon} alt="" class="h-10 w-10" />
        <CardTitle>Humidity</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="text-3xl font-semibold tabular-nums" data-field="humidity">
          {fmt(reading?.humidity ?? null, 0, "%")}
        </div>
      </CardContent>
    </Card>

    <Card>
      <CardHeader className="flex items-center gap-2">
        <img src={pressureIcon} alt="" class="h-10 w-10" />
        <CardTitle>Pressure</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="text-3xl font-semibold tabular-nums" data-field="pressure_msl_hpa">
          {fmt(reading?.pressure_msl_hpa ?? null, 0, " hPa")}
        </div>
        <p class="mt-1 text-xs text-muted-foreground">sea-level adjusted</p>
      </CardContent>
    </Card>

    <Card>
      <CardHeader className="flex items-center gap-2">
        <img src={windIcon} alt="" class="h-10 w-10" />
        <CardTitle>Wind</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="text-3xl font-semibold tabular-nums" data-field="wind_speed_ms">
          {fmt(reading?.wind_speed_ms ?? null, 1, " m/s")}
        </div>
        <p class="mt-1 text-xs text-muted-foreground">
          gust <span data-field="wind_gust_ms">{fmt(reading?.wind_gust_ms ?? null, 1, " m/s")}</span>
          · <span data-field="wind_dir">{degToCompass(reading?.wind_dir_deg ?? null)}</span>
        </p>
      </CardContent>
    </Card>

    <Card>
      <CardHeader className="flex items-center gap-2">
        <img src={compassIcon} alt="" class="h-10 w-10" />
        <CardTitle>Wind Direction</CardTitle>
      </CardHeader>
      <CardContent className="flex items-center gap-4">
        <div id="wind-compass" class="h-20 w-20 shrink-0" set:html={compassSvg} />
        <div>
          <div class="text-2xl font-semibold tabular-nums" data-field="wind_dir_label">
            {degToCompass(reading?.wind_dir_deg ?? null)}
          </div>
          <p class="text-sm text-muted-foreground tabular-nums" data-field="wind_dir_deg">
            {reading?.wind_dir_deg ?? "—"}°
          </p>
        </div>
      </CardContent>
    </Card>

    <Card>
      <CardHeader className="flex items-center gap-2">
        <img src={rainIcon} alt="" class="h-10 w-10" />
        <CardTitle>Rain (interval)</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="text-3xl font-semibold tabular-nums" data-field="rain_mm">
          {fmt(reading?.rain_mm ?? null, 1, " mm")}
        </div>
      </CardContent>
    </Card>
  </div>
</div>

<script>
  const FIELD_UNITS: Record<string, { digits: number; unit: string }> = {
    temp_c: { digits: 1, unit: "°C" },
    dewpoint_c: { digits: 1, unit: "°C" },
    humidity: { digits: 0, unit: "%" },
    pressure_msl_hpa: { digits: 0, unit: " hPa" },
    wind_speed_ms: { digits: 1, unit: " m/s" },
    wind_gust_ms: { digits: 1, unit: " m/s" },
    rain_mm: { digits: 1, unit: " mm" },
  };
  const COMPASS = [
    "N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE",
    "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW",
  ];

  function fmt(value: number | null, digits: number, unit: string) {
    if (value === null || Number.isNaN(value)) return "—";
    return `${value.toFixed(digits)}${unit}`;
  }

  function timeAgo(iso: string) {
    const seconds = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000);
    if (seconds < 90) return "just now";
    const minutes = Math.round(seconds / 60);
    if (minutes < 60) return `${minutes}m ago`;
    return `${Math.round(minutes / 60)}h ago`;
  }

  async function refresh() {
    try {
      const res = await fetch("/api/current");
      if (!res.ok) return;
      const reading = await res.json();
      if (!reading) return;

      const root = document.getElementById("current-conditions");
      if (!root) return;
      root.dataset.recordedAt = reading.recorded_at;

      for (const [field, { digits, unit }] of Object.entries(FIELD_UNITS)) {
        const el = root.querySelector(`[data-field="${field}"]`);
        if (el) el.textContent = fmt(reading[field], digits, unit);
      }
      const windDirEl = root.querySelector('[data-field="wind_dir"]');
      if (windDirEl && reading.wind_dir_deg !== null) {
        const index = Math.round(reading.wind_dir_deg / 22.5) % 16;
        windDirEl.textContent = COMPASS[index];
      }
      const windDirLabelEl = root.querySelector('[data-field="wind_dir_label"]');
      const windDirDegEl = root.querySelector('[data-field="wind_dir_deg"]');
      if (reading.wind_dir_deg !== null) {
        const index = Math.round(reading.wind_dir_deg / 22.5) % 16;
        if (windDirLabelEl) windDirLabelEl.textContent = COMPASS[index];
        if (windDirDegEl) windDirDegEl.textContent = `${reading.wind_dir_deg}°`;
        const pointer = document.querySelector("#wind-compass #Pointer");
        pointer?.setAttribute("transform", `rotate(${Math.round(reading.wind_dir_deg)} 64 64)`);
      }
      const updatedEl = document.getElementById("updated-label");
      if (updatedEl) updatedEl.textContent = `updated ${timeAgo(reading.recorded_at)}`;
    } catch {
      // network hiccup — next interval will retry
    }
  }

  function tickAge() {
    const root = document.getElementById("current-conditions");
    const updatedEl = document.getElementById("updated-label");
    const recordedAt = root?.dataset.recordedAt;
    if (updatedEl && recordedAt) updatedEl.textContent = `updated ${timeAgo(recordedAt)}`;
  }

  tickAge();
  setInterval(tickAge, 15_000);
  setInterval(refresh, 45_000);
</script>
