---
// Renders one Meteocons "flat" weather glyph by basename, from the Nord-coloured
// copies in public/weather-icons/ (see scripts/generate-weather-icons.mjs, whose
// list must cover every basename the WMO map in lib/forecast.ts can produce).
// Anything unknown falls back to overcast-day.
//
// Still by default. `animated` is for the one hero icon: it moves (at half
// speed) unless the viewer has asked their device to reduce motion.
const KNOWN = new Set([
  "clear-day",
  "clear-night",
  "partly-cloudy-day",
  "partly-cloudy-night",
  "partly-cloudy-day-rain",
  "partly-cloudy-night-rain",
  "overcast-day",
  "overcast-night",
  "fog-day",
  "fog-night",
  "drizzle",
  "sleet",
  "rain",
  "snow",
  "thunderstorms-day",
  "thunderstorms-night",
  "thunderstorms-day-rain",
  "thunderstorms-night-rain",
]);

interface Props {
  name: string;
  class?: string;
  alt?: string;
  animated?: boolean;
}
const { name, class: klass, alt = "", animated = false } = Astro.props;
const base = `/weather-icons/${KNOWN.has(name) ? name : "overcast-day"}`;
---

{
  animated ? (
    <picture>
      <source srcset={`${base}.svg`} media="(prefers-reduced-motion: reduce)" />
      <img src={`${base}-animated.svg`} alt={alt} class={klass} />
    </picture>
  ) : (
    <img src={`${base}.svg`} alt={alt} class={klass} />
  )
}
