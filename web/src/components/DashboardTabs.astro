---
// Top-level dashboard tabs: Now / History / Ahead. An Astro wrapper with named
// slots — NOT the shadcn React <Tabs> — because Astro server islands
// (`server:defer`) can't be children of a React island. Each panel's content is
// always in the DOM (server islands still stream in while hidden); a small
// script toggles `hidden` + `aria-selected`, syncs the URL hash and restores
// the last tab.
// Inline Lucide-style glyphs (matches the header theme toggle's approach).
const ICONS: Record<string, string> = {
  // activity / pulse — "live, right now"
  now: '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
  // line chart — "what it has done"
  history:
    '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m19 9-5 5-4-4-3 3"/>',
  // calendar days — "the days ahead"
  ahead:
    '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/>',
};

const tabs = [
  { id: "now", label: "Now in detail" },
  { id: "history", label: "History" },
  { id: "ahead", label: "Ahead" },
] as const;
---

<div id="dashboard">
  <div
    role="tablist"
    aria-label="Dashboard views"
    class="sticky top-0 z-20 -mx-4 mb-8 flex gap-1 overflow-x-auto border-b border-border bg-background/85 px-4 backdrop-blur sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8"
  >
    {
      tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          data-tab={t.id}
          aria-controls={`panel-${t.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          class="-mb-px flex shrink-0 items-center gap-2 border-b-2 border-transparent px-4 py-3 text-base font-medium text-muted-foreground transition-colors hover:text-foreground aria-selected:border-foreground aria-selected:text-foreground"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="h-5 w-5 shrink-0"
            set:html={ICONS[t.id]}
          />
          {t.label}
        </button>
      ))
    }
  </div>

  {
    tabs.map((t, i) => (
      <div
        role="tabpanel"
        id={`panel-${t.id}`}
        aria-labelledby={`tab-${t.id}`}
        data-panel={t.id}
        hidden={i !== 0}
        tabindex="0"
      >
        <slot name={t.id} />
      </div>
    ))
  }
</div>

<script>
  const root = document.getElementById("dashboard");
  if (root) {
    const tabEls = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = new Map(
      [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')].map((p) => [
        p.dataset.panel as string,
        p,
      ]),
    );
    const ids = tabEls.map((t) => t.dataset.tab as string);
    const STORE_KEY = "dashboard-tab";

    function activate(id: string, focusTab = false) {
      if (!panels.has(id)) return;
      for (const tab of tabEls) {
        const on = tab.dataset.tab === id;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focusTab) tab.focus();
      }
      for (const [pid, panel] of panels) panel.hidden = pid !== id;
      if (location.hash.slice(1) !== id) {
        history.replaceState(null, "", `#${id}`);
      }
      try {
        localStorage.setItem(STORE_KEY, id);
      } catch {
        /* private mode — fine */
      }
      // ECharts in a panel that was `hidden` (0px wide) needs a nudge to refit.
      window.dispatchEvent(new Event("resize"));
    }

    for (const tab of tabEls) {
      tab.addEventListener("click", () => activate(tab.dataset.tab as string));
    }

    const tablist = root.querySelector('[role="tablist"]');
    tablist?.addEventListener("keydown", (event) => {
      const e = event as KeyboardEvent;
      const current = tabEls.findIndex((t) => t.getAttribute("aria-selected") === "true");
      if (current < 0) return;
      if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
        e.preventDefault();
        const delta = e.key === "ArrowRight" ? 1 : -1;
        activate(ids[(current + delta + ids.length) % ids.length], true);
      } else if (e.key === "Home") {
        e.preventDefault();
        activate(ids[0], true);
      } else if (e.key === "End") {
        e.preventDefault();
        activate(ids[ids.length - 1], true);
      }
    });

    window.addEventListener("hashchange", () => {
      activate(location.hash.slice(1) || "now");
    });

    let initial = location.hash.slice(1);
    if (!ids.includes(initial)) {
      try {
        initial = localStorage.getItem(STORE_KEY) || "";
      } catch {
        initial = "";
      }
    }
    activate(ids.includes(initial) ? initial : "now");
  }
</script>
