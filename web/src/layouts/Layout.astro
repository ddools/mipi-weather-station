---
import "@/styles/global.css";

interface Props {
  title?: string;
}
const { title = "Skerries Weather Station" } = Astro.props;
const description =
  "Live weather from a Raspberry Pi weather station in Skerries, Co. Dublin — " +
  "temperature, wind, pressure, humidity and rainfall, updated every minute.";
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://weather.dermotdooley.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    <link rel="canonical" href={canonical.href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skerries Weather Station" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      // Runs before paint to avoid a flash of the wrong theme.
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground">
    <header class="mx-auto flex w-full max-w-6xl items-start justify-between px-4 py-6 sm:px-6">
      <div>
        <h1 class="text-lg font-semibold">{title}</h1>
        <p class="mt-0.5 text-xs text-muted-foreground tabular-nums">
          Skerries, Co. Dublin · 53.58°N 6.11°W · readings every 60s
        </p>
      </div>
      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-border bg-background text-sm hover:bg-muted"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" id="theme-icon-light" class="lucide lucide-sun hidden h-4 w-4"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" id="theme-icon-dark" class="lucide lucide-moon h-4 w-4"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path></svg>
      </button>
    </header>
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 pb-16 sm:px-6">
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-6xl px-4 pb-10 text-xs text-muted-foreground sm:px-6">
      <p>
        Built by <a
          class="underline underline-offset-2 hover:text-foreground"
          href="https://dermotdooley.com"
          rel="noopener">Dermot Dooley</a>.
      </p>

    </footer>
    <script is:inline>
      (function () {
        const button = document.getElementById("theme-toggle");
        const lightIcon = document.getElementById("theme-icon-light");
        const darkIcon = document.getElementById("theme-icon-dark");
        function sync() {
          const isDark = document.documentElement.classList.contains("dark");
          // Show the icon for the theme you'd switch to.
          lightIcon?.classList.toggle("hidden", !isDark);
          darkIcon?.classList.toggle("hidden", isDark);
        }
        sync();
        button?.addEventListener("click", () => {
          const isDark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", isDark ? "dark" : "light");
          sync();
        });
      })();
    </script>
  </body>
</html>
