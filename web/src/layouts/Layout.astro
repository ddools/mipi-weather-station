---
import "@/styles/global.css";
import StationLinks from "@/components/StationLinks.astro";
import ServiceWorker from "@/components/ServiceWorker.astro";

interface Props {
  title?: string;
}
const { title = "Skerries Weather Station" } = Astro.props;
const description =
  "Live weather from a Raspberry Pi weather station in Skerries, Co. Dublin — " +
  "temperature, wind, pressure, humidity and rainfall, updated every minute.";
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://weather.dermotdooley.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#3b4252" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Skerries Wx" />
    <link rel="canonical" href={canonical.href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skerries Weather Station" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      // Same as www.dermotdooley.com: dark unless you've picked light, on any of the
      // dermotdooley.com sites — the choice is shared through a `theme` cookie on the parent
      // domain. localStorage is the fallback, and still holds "dark"/"light" from before the
      // cookie. The theme is the `dark` class shadcn keys off. Runs before paint, so no flash.
      (() => {
        let theme = document.cookie.match(/(?:^|;\s*)theme=(dermot-dark|dermot-light)/)?.[1];
        if (!theme) {
          let stored = null;
          try {
            stored = localStorage.getItem("theme");
          } catch {}
          theme = stored === "dermot-light" || stored === "light" ? "dermot-light" : "dermot-dark";
        }
        const isDark = theme === "dermot-dark";
        document.documentElement.classList.toggle("dark", isDark);
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", isDark ? "#3b4252" : "#e5e9f0");
      })();
    </script>
    <ServiceWorker />
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground">
    <!-- Mirrors the navbar on www.dermotdooley.com (and train.dermotdooley.com): same
         Nord base-200 bar, logo home on the left, ghost circle buttons on the right. -->
    <header class="sticky top-0 z-50 flex h-16 items-center bg-navbar px-4 shadow-sm lg:px-8">
      <div class="flex w-1/2 min-w-0 items-center">
        <a
          href="https://www.dermotdooley.com"
          class="flex items-center gap-2 font-bold text-foreground transition-colors hover:text-navbar-accent"
        >
          <img src="/dermotdooley.svg" alt="DD" width="32" height="32" class="h-8 w-8 shrink-0" />
          <span class="hidden sm:inline">Dermot Dooley</span>
        </a>
      </div>
      <h1 class="shrink-0 px-2 font-semibold tracking-tight whitespace-nowrap">{title}</h1>
      <div class="flex w-1/2 min-w-0 items-center justify-end gap-1">
        <button
          id="install-app"
          type="button"
          class="hidden h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-foreground/10"
          aria-label="Install app"
          title="Install app"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="lucide lucide-monitor-down h-4 w-4"><path d="M12 13V7"></path><path d="m15 10-3 3-3-3"></path><rect width="20" height="14" x="2" y="3" rx="2"></rect><path d="M12 17v4"></path><path d="M8 21h8"></path></svg>
        </button>
        <button
          id="theme-toggle"
          type="button"
          class="inline-flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-foreground/10"
          aria-label="Toggle theme"
          title="Toggle light / dark"
        >
          <!-- The icon shows the current theme, as on the main site. -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" id="theme-icon-light" class="lucide lucide-sun hidden h-4 w-4"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" id="theme-icon-dark" class="lucide lucide-moon h-4 w-4"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path></svg>
        </button>
      </div>
    </header>
    <main class="mx-auto w-full max-w-[1400px] flex-1 px-4 pt-6 pb-16 sm:px-6 lg:px-8">
      <p class="mb-4 flex flex-wrap gap-x-2 text-xs text-muted-foreground tabular-nums">
        <span>Skerries, Co.&nbsp;Dublin</span>
        <span class="hidden sm:inline" aria-hidden="true">·</span>
        <span class="hidden sm:inline">53.58°N&nbsp;6.11°W</span>
        <span aria-hidden="true">·</span>
        <span>readings every 60s</span>
      </p>
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-[1400px] px-4 pb-10 text-xs text-muted-foreground sm:px-6 lg:px-8">
      <StationLinks class="mb-6" />
      <p>
        Built by <a
          class="underline underline-offset-2 hover:text-foreground"
          href="https://dermotdooley.com"
          rel="noopener">Dermot Dooley</a>.
      </p>

    </footer>
    <script is:inline>
      (() => {
        const button = document.getElementById("theme-toggle");
        const lightIcon = document.getElementById("theme-icon-light");
        const darkIcon = document.getElementById("theme-icon-dark");

        // Saved the same way as www.dermotdooley.com, so the choice follows you between the
        // dermotdooley.com sites: a cookie on the parent domain (only there — localhost and
        // Vercel preview URLs keep it to themselves), plus localStorage as a fallback.
        function saveTheme(theme) {
          try {
            localStorage.setItem("theme", theme);
          } catch {}
          const domain = /(^|\.)dermotdooley\.com$/.test(location.hostname) ? "; domain=dermotdooley.com" : "";
          const secure = location.protocol === "https:" ? "; secure" : "";
          document.cookie = `theme=${theme}; path=/; max-age=31536000; samesite=lax${domain}${secure}`;
        }

        function sync() {
          const isDark = document.documentElement.classList.contains("dark");
          lightIcon?.classList.toggle("hidden", isDark);
          darkIcon?.classList.toggle("hidden", !isDark);
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", isDark ? "#3b4252" : "#e5e9f0");
        }

        sync();
        button?.addEventListener("click", () => {
          const isDark = document.documentElement.classList.toggle("dark");
          saveTheme(isDark ? "dermot-dark" : "dermot-light");
          sync();
        });

        // Install button, shown only when the browser offers an install prompt (Chromium).
        const install = document.getElementById("install-app");
        let deferred = null;
        const syncInstall = () => {
          install?.classList.toggle("hidden", !deferred);
          install?.classList.toggle("inline-flex", !!deferred);
        };
        window.addEventListener("beforeinstallprompt", (event) => {
          event.preventDefault();
          deferred = event;
          syncInstall();
        });
        window.addEventListener("appinstalled", () => {
          deferred = null;
          syncInstall();
        });
        install?.addEventListener("click", async () => {
          if (!deferred) return;
          const prompt = deferred;
          deferred = null;
          syncInstall();
          await prompt.prompt();
        });
      })();
    </script>
  </body>
</html>
