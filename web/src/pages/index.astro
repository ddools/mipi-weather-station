---
import Layout from "@/layouts/Layout.astro";
import CurrentConditions from "@/components/CurrentConditions.astro";
import { HistoryCharts } from "@/components/HistoryCharts";
import { Skeleton } from "@/components/ui/skeleton";
---

<Layout>
  <section class="mb-10">
    <CurrentConditions server:defer>
      <div slot="fallback" class="space-y-4">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <Skeleton className="h-32" />
          <Skeleton className="h-32" />
          <Skeleton className="h-32" />
        </div>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
          <Skeleton className="h-40 lg:col-span-2" />
          <Skeleton className="h-40" />
        </div>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
          <Skeleton className="h-40" />
          <Skeleton className="h-[420px] lg:col-span-2" />
        </div>
      </div>
    </CurrentConditions>
  </section>

  <section>
    <h2 class="mb-4 text-base font-semibold text-muted-foreground">History</h2>
    <HistoryCharts client:load />
  </section>
</Layout>
