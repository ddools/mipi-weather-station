# Copy to .env — never commit the real file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...          # service role key (Pi only, never in the web app)
WU_STATION_KEY=                      # Weather Underground station key
WINDY_STATION_PASSWORD=              # Windy station password (My Stations page) — NOT the account API key
CWOP_PASSCODE=-1                     # -1 for a CW/DW/EW id; a real APRS-IS passcode only for a ham callsign
WOWBE_AUTH_KEY=                      # wow.meteo.be site authentication key (PIN chosen at registration)
